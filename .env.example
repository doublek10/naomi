# ---------------------------------------------------------------------
# db-bridge (cPanel) — server-side only, never NEXT_PUBLIC_
# ---------------------------------------------------------------------
DB_BRIDGE_URL=https://danasresidency.co.ke/api/database.php
DB_BRIDGE_API_KEY=replace-with-a-long-random-secret

# ---------------------------------------------------------------------
# NextAuth
# ---------------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
# openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32

# ---------------------------------------------------------------------
# Cron / webhook protection
# ---------------------------------------------------------------------
# Shared secret Vercel Cron sends as a Bearer token so the route can't be
# triggered by a random visitor. Vercel automatically sends this as
# `Authorization: Bearer $CRON_SECRET` for routes configured in vercel.json.
CRON_SECRET=replace-with-another-long-random-secret

# Optional: if KCB ever supports a shared signing secret for the webhook,
# put it here and verify it in app/api/webhooks/kcb/route.ts. Until then,
# rely on IP allowlisting at the platform/network level if KCB publishes
# their outbound IP ranges.
KCB_WEBHOOK_SECRET=

# ---------------------------------------------------------------------
# App
# ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
